# Deploy-time variables (used by `npm run deploy:poc`).
# Copy to .env.deploy.local and fill in your values. Never commit real credentials.
POC_AWS_REGION=us-east-1

# Profile for the account that owns the artifact bucket
POC_ARTIFACT_AWS_PROFILE=<AWS_PROFILE>

# Profile for the account that owns the deployed Lambda function
POC_LAMBDA_AWS_PROFILE=<AWS_PROFILE>

# S3 bucket and key for the lambda deployment artifact
POC_LAMBDA_ARTIFACT_BUCKET=<ARTIFACT_BUCKET>
POC_LAMBDA_ARTIFACT_KEY=easycmdb/dev/easycmdb-api.zip

# Function name in the target account
POC_LAMBDA_FUNCTION_NAME=<LAMBDA_FUNCTION_NAME>

# Set to 1 to skip the local build step and only re-upload an existing bundle.zip
# POC_SKIP_BUILD=1
