# Local API. Copy to .env.local. These values match docker-compose.yml.
AUTH_MODE=basic
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=easycmdb
PGPASSWORD=easycmdb
PGDATABASE=easycmdb
PG_SSL=false

# Viewer is read-only. Admin can open Management.
BASIC_AUTH_USER=viewer
BASIC_AUTH_PASSWORD=viewer
BASIC_AUTH_ADMIN_USER=admin
BASIC_AUTH_ADMIN_PASSWORD=admin
